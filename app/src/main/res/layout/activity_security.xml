<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:background="#F5F7FB" android:fitsSystemWindows="true"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/bg_gradient" android:padding="14dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/backButton" android:text="←" android:textColor="#FFFFFF" android:textSize="26sp"
            android:padding="8dp" android:clickable="true" android:contentDescription="Voltar"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="Segurança" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"
            android:layout_marginStart="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout android:orientation="vertical" android:padding="16dp"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <TextView android:id="@+id/deviceInfo" android:textColor="#374151" android:textSize="13sp"
            android:lineSpacingExtra="3dp" android:background="@drawable/card_bg" android:padding="14dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <LinearLayout android:orientation="horizontal" android:layout_marginTop="12dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/tabApps" android:text="APPS INSTALADOS" android:textSize="13sp" android:textStyle="bold"
                android:backgroundTint="@null" android:stateListAnimator="@null" android:minHeight="44dp"
                android:layout_marginEnd="6dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" />
            <Button android:id="@+id/tabApks" android:text="APKs BAIXADOS" android:textSize="13sp" android:textStyle="bold"
                android:backgroundTint="@null" android:stateListAnimator="@null" android:minHeight="44dp"
                android:layout_marginStart="6dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" />
        </LinearLayout>

        <TextView android:id="@+id/scanStatus" android:text="" android:textColor="#6B7280" android:textSize="13sp"
            android:layout_marginTop="12dp" android:layout_marginBottom="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <ListView android:id="@+id/list" android:divider="@android:color/transparent" android:dividerHeight="8dp"
            android:clipToPadding="false" android:scrollbars="none"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
